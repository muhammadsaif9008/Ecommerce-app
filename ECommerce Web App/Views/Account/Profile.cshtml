@model ECommerceApp.Models.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-header">
    <div class="profile-avatar">@Model.Username[0].ToString().ToUpper()</div>
    <div class="profile-info">
        <h1>@Model.Username</h1>
        <span class="badge badge-gray">Member</span>
    </div>
</div>

<div class="profile-stats">
    <div class="stat-box">
        <div class="stat-value">@Model.AverageRating.ToString("0.0")</div>
        <div class="stat-label">Avg Rating Given</div>
    </div>
    <div class="stat-box">
        <div class="stat-value">@Model.Reviews.Count</div>
        <div class="stat-label">Reviews Written</div>
    </div>
</div>

<div class="reviews-list">
    <h2>My Reviews</h2>
    @if (!Model.Reviews.Any())
    {
        <p style="color:var(--text-muted); font-size:0.9rem;">You haven't reviewed any items yet.</p>
    }
    else
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="review-row">
                <div class="review-item-name">@review.ItemName</div>
                <div class="review-text">@review.Text</div>
            </div>
        }
    }
</div>