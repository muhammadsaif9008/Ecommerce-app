@model ECommerceApp.Models.Item
@{
ViewData["Title"] = Model.Name;
}

<a asp-controller="Home" asp-action="Index" style="font-size:0.8rem; color:var(--text-muted); text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem; margin-bottom:2rem;">
    ← Back to Collection
</a>

<div class="detail-grid">
    <div>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
        <img src="@Model.ImageUrl" class="detail-img" alt="@Model.Name" />
        }
        else
        {
        <div class="detail-img-placeholder">◈</div>
        }
    </div>
    <div>
        <div class="detail-eyebrow">@Model.Category</div>
        <h1 class="detail-title">@Model.Name</h1>
        <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
            <span class="badge @(Model.Condition == "New" ? "badge-gold" : "badge-gray")">@Model.Condition</span>
            <span class="badge badge-gray">@Model.Seller</span>
        </div>
        <div class="detail-price">€@Model.Price</div>
        <p class="detail-desc">@Model.Description</p>
        <div class="spec-grid">
            @if (Model.BatteryLife.HasValue)
            {
            <div class="spec-item"><div class="spec-key">Battery Life</div><div class="spec-val">@Model.BatteryLife hrs</div></div>
            }
            @if (Model.Age.HasValue)
            {
            <div class="spec-item"><div class="spec-key">Age</div><div class="spec-val">@Model.Age years</div></div>
            }
            @if (!string.IsNullOrEmpty(Model.Size))
            {
            <div class="spec-item"><div class="spec-key">Size</div><div class="spec-val">@Model.Size</div></div>
            }
            @if (!string.IsNullOrEmpty(Model.Material))
            {
            <div class="spec-item"><div class="spec-key">Material</div><div class="spec-val">@Model.Material</div></div>
            }
        </div>
        <div class="rating-display">
            <div class="rating-num">@Model.AverageRating.ToString("0.0")</div>
            <div>
                <div class="stars">★★★★★</div>
                <div class="rating-meta">@Model.Ratings.Count ratings</div>
            </div>
        </div>
        @if (User.Identity!.IsAuthenticated && !User.IsInRole("admin"))
        {
        <div class="rate-form">
            <h4>Rate This Item</h4>
            <form asp-controller="Item" asp-action="Rate" method="post">
                <input type="hidden" name="itemId" value="@Model.Id" />
                <div class="rate-row">
                    <select name="score" style="width:auto;">
                        <option value="1">1 Star</option>
                        <option value="2">2 Stars</option>
                        <option value="3">3 Stars</option>
                        <option value="4">4 Stars</option>
                        <option value="5" selected>5 Stars</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
        }
    </div>
</div>

<hr class="divider" />

<div class="reviews-section">
    <h2>Reviews (@Model.Reviews.Count)</h2>
    @if (!Model.Reviews.Any())
    {
    <p style="color:var(--text-muted); font-size:0.9rem;">No reviews yet.</p>
    }
    else
    {
    @foreach (var review in Model.Reviews)
    {
    <div class="review-card">
        <div class="review-header">
            <span class="reviewer-name">@review.Username</span>
            <span class="review-date">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
        </div>
        <p class="review-text">@review.Text</p>
    </div>
    }
    }
    @if (User.Identity!.IsAuthenticated && !User.IsInRole("admin"))
    {
    <div class="write-review">
        <h3>Write a Review</h3>
        <form asp-controller="Item" asp-action="Review" method="post">
            <input type="hidden" name="itemId" value="@Model.Id" />
            <div class="form-group">
                <textarea name="text" rows="4" placeholder="Share your thoughts..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Review</button>
        </form>
    </div>
    }
</div>