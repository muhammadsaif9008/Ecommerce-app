<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Luxe Market</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/site.css" />
</head>
<body>
<nav>
    <a class="nav-brand" asp-controller="Home" asp-action="Index">Luxe<span>Market</span></a>
    <ul class="nav-links">
        @if (User.Identity!.IsAuthenticated)
        {
            if (User.IsInRole("admin"))
            {
                <li><a asp-controller="Admin" asp-action="Index">Admin Panel</a></li>
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Profile">My Profile</a></li>
            }
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    <button class="btn-nav-outline">Sign Out</button>
                </form>
            </li>
        }
        else
        {
            <li><a asp-controller="Account" asp-action="Login" class="btn-nav">Sign In</a></li>
        }
    </ul>
</nav>

<main>
    @RenderBody()
</main>

<footer>
    © 2026 LuxeMarket — Built with ASP.NET Core 8 · MongoDB Atlas · Azure VM
</footer>
</body>
</html>