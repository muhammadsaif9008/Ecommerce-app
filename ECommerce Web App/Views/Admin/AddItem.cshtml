@{
    ViewData["Title"] = "Add Item";
}

<a asp-action="Index" style="font-size:0.8rem; color:var(--text-muted); text-decoration:none; display:inline-flex; gap:0.4rem; margin-bottom:2rem;">← Back to Admin Panel</a>

<div class="form-page-header">
    <div class="eyebrow">Admin</div>
    <h1>Add New Item</h1>
</div>

<div class="form-panel">
    <form asp-action="AddItem" method="post">
        <div class="form-row">
            <div class="form-group">
                <label>Item Name</label>
                <input type="text" name="Name" required placeholder="Enter item name" />
            </div>
            <div class="form-group">
                <label>Price (€)</label>
                <input type="number" name="Price" step="0.01" required placeholder="0.00" />
            </div>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea name="Description" rows="3" placeholder="Describe the item..."></textarea>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Seller</label>
                <input type="text" name="Seller" placeholder="Seller name" />
            </div>
            <div class="form-group">
                <label>Category</label>
                <select name="Category" required>
                    <option value="">— Select Category —</option>
                    <option>Vinyls</option>
                    <option>Antique Furniture</option>
                    <option>GPS Sport Watches</option>
                    <option>Running Shoes</option>
                    <option>Camping Tents</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Condition</label>
                <select name="Condition">
                    <option>New</option>
                    <option>Used</option>
                </select>
            </div>
            <div class="form-group">
                <label>Image URL</label>
                <input type="text" name="ImageUrl" placeholder="https://..." />
            </div>
        </div>
        <div class="form-section-title">Category-Specific Fields</div>
        <div class="form-row">
            <div class="form-group">
                <label>Battery Life (hrs) — GPS Watches</label>
                <input type="number" name="BatteryLife" placeholder="e.g. 13" />
            </div>
            <div class="form-group">
                <label>Age (years) — Antiques & Vinyls</label>
                <input type="number" name="Age" placeholder="e.g. 50" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Size — Running Shoes</label>
                <input type="text" name="Size" placeholder="e.g. EU 42" />
            </div>
            <div class="form-group">
                <label>Material — Antiques & Shoes</label>
                <input type="text" name="Material" placeholder="e.g. Oak, Mesh" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add Item</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>